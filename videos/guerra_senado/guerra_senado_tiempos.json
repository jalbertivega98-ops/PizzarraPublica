  "frases": [
   {
    "t0": 0.0,
    "t1": 2.59,
    "texto": "Por primera vez, el PSOE y el Frente Amplio van juntos…"
   },
   {
    "t0": 2.74,
    "t1": 4.28,
    "texto": "pero solo al Senado. ¿Por qué?"
   }
  ]
 },
 {
  "escena": "reglas",
  "inicio": 4.73,
  "fin": 11.7,
  "frases": [
   {
    "t0": 5.03,
    "t1": 7.41,
    "texto": "En el Senado, cada provincia elige cuatro senadores."
   },
   {
    "t0": 7.51,
    "t1": 8.31,
    "texto": "Tú marcas tres,"
   },
   {
    "t0": 8.46,
    "t1": 11.25,
    "texto": "y el primero suele llevarse tres; el segundo, uno."
   }
  ]
 },
 {
