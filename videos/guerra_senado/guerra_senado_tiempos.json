  "inicio": 11.7,
  "fin": 17.93,
  "frases": [
   {
    "t0": 11.96,
    "t1": 14.09,
    "texto": "Si la izquierda va dividida, gana el PP:"
   },
   {
    "t0": 14.24,
    "t1": 17.48,
    "texto": "en 2023 sacó 120 senadores; el PSOE, 72."
   }
  ]
 },
 {
  "escena": "mapa",
  "inicio": 17.93,
  "fin": 22.58,
  "frases": [
   {
    "t0": 18.25,
    "t1": 22.13,
    "texto": "Por eso ahora van juntos con el nombre de «Senado de Progreso», en 47 provincias."
   }
  ]
 },
 {
  "escena": "vox",
  "inicio": 22.58,
  "fin": 30.62,
  "frases": [
   {
    "t0": 23.03,
    "t1": 30.17,
    "texto": "El lunes, Abascal le ofreció al PP un entendimiento y pidió sacrificios, sin concretar. El PP no ha respondido; hay hasta el 26 de octubre."
   }
  ]
 },
 {
  "escena": "simulacion",
